#!/bin/sh
# Human-only break glass. The launcher automatically expires this sentinel
# after eight hours.
set -eu

if [ -z "${HOME:-}" ]; then
	echo "guard-disable: HOME must be set" >&2
	exit 1
fi
umask 077
mkdir -p "$HOME/.config/agent-guard"
: >"$HOME/.config/agent-guard/disabled"
echo "Agent Guard disabled for at most eight hours."
